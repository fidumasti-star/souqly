import pandas as pd
import re

INPUT = "supplier_catalog.csv"
MIN_NET_MARGIN = 0.10  # Minimum net margin required AFTER ad spend, shipping, COGS, and COD returns (10%)
MIN_NET_PROFIT_SAR = 15.0  # Minimum required net SAR profit per order attempt
TOP_N = 50

# --- KSA Logistics & Operational Constants ---
SHIPPING_COST_SAR = 22.0   # Last-mile delivery fee
RETURN_COST_SAR = 15.0     # Return-to-Origin (RTO) processing fee
COD_SHARE = 0.60           # 60% of orders paid via Cash on Delivery
COD_RTO_RATE = 0.20        # 20% of COD orders returned at delivery

# --- Marketing & Acquisition Constants ---
TARGET_ROAS = 2.5          # Target Return on Ad Spend (e.g., 2.5x ROAS = Ad Spend is 40% of Retail Price)

df = pd.read_csv(INPUT)
required = ["product_name", "category", "supplier_cost_sar", "retail_price_sar", "demand_score", "competition_score"]
missing = [c for c in required if c not in df.columns]
if missing:
    raise ValueError("Missing columns: " + ", ".join(missing))

# Drop invalid rows to prevent calculation errors
df = df.dropna(subset=["supplier_cost_sar", "retail_price_sar", "demand_score", "competition_score"])
df = df[df["retail_price_sar"] > 0].copy()

# --- Logistics & COD Metrics ---
total_rto_rate = COD_SHARE * COD_RTO_RATE               # 12% overall RTO rate
delivered_rate = 1.0 - total_rto_rate                     # 88% overall delivered rate

df["expected_revenue_sar"] = df["retail_price_sar"] * delivered_rate
df["expected_shipping_sar"] = SHIPPING_COST_SAR + (total_rto_rate * RETURN_COST_SAR)
df["expected_supplier_cost_sar"] = df["supplier_cost_sar"]

# --- Ad Spend (CPA / ROAS) Metrics ---
# Target CPA (Cost Per Acquisition) derived from Target ROAS: Retail Price / Target ROAS
df["target_cpa_sar"] = df["retail_price_sar"] / TARGET_ROAS

# Break-even CPA: The maximum ad spend allowed before the product loses money
df["breakeven_cpa_sar"] = (
    df["expected_revenue_sar"] 
    - df["expected_supplier_cost_sar"] 
    - df["expected_shipping_sar"]
)

# --- Net Profitability Math (After COGS + Shipping + COD RTO Losses + Ad Spend) ---
df["net_profit_sar"] = df["breakeven_cpa_sar"] - df["target_cpa_sar"]
df["net_margin"] = df["net_profit_sar"] / df["retail_price_sar"]

# Filter by minimum profit thresholds after accounting for marketing costs
df = df[
    (df["net_margin"] >= MIN_NET_MARGIN) & 
    (df["net_profit_sar"] >= MIN_NET_PROFIT_SAR)
].copy()

# --- Opportunity Scoring Algorithm ---
# demand_score: 1-10, higher is better
# competition_score: 1-10, lower is better
df["opportunity_score"] = (
    df["demand_score"] * 0.40
    + (10 - df["competition_score"]) * 0.30
    + (df["net_margin"].clip(0, 1) * 10) * 0.30
)
df = df.sort_values(["opportunity_score", "net_profit_sar"], ascending=False).head(TOP_N)
df.to_csv("ksa_opportunities.csv", index=False, encoding="utf-8-sig")

def generate_slug(text):
    text = str(text).strip().replace(" ", "-")
    text = re.sub(r'[^\w\-]', '', text) 
    return re.sub(r'-+', '-', text).lower()

# --- Build Shopify Import DataFrame ---
shop = pd.DataFrame()
shop["Handle"] = df["product_name"].apply(generate_slug)
shop["Title"] = df["product_name"]
shop["Body (HTML)"] = df["product_name"].apply(lambda x: f"<p>{x}</p>")
shop["Vendor"] = "KSA Drop"
shop["Type"] = df["category"]
shop["Tags"] = "KSA,Dropshipping,Saudi Arabia"
shop["Published"] = "FALSE"
shop["Option1 Name"] = "Title"
shop["Option1 Value"] = "Default Title"
shop["Variant SKU"] = [f"KSA-{i:03d}" for i in range(1, len(df) + 1)]
shop["Variant Inventory Policy"] = "deny"
shop["Variant Fulfillment Service"] = "manual"

# Pricing Strategy
shop["Variant Price"] = df["retail_price_sar"]
shop["Variant Compare At Price"] = (df["retail_price_sar"] * 1.30).round(2)
shop["Cost per item"] = df["supplier_cost_sar"]

shop["Variant Requires Shipping"] = "TRUE"
shop["Variant Taxable"] = "TRUE"
shop["Image Src"] = df["image_url"] if "image_url" in df.columns else ""
shop["Status"] = "draft"

# SEO Metadata
shop["SEO Title"] = df["product_name"].apply(lambda x: str(x)[:70])
shop["SEO Description"] = df["product_name"].apply(lambda x: f"Buy {str(x)} online in Saudi Arabia. Fast delivery and COD available!"[:320])

shop.to_csv("shopify_import.csv", index=False, encoding="utf-8-sig")
print(f"Exported {len(df)} products with full acquisition and KSA fulfillment metrics applied.")
